# Copier en deploy/.env sur le VPS (cp .env.example .env) puis remplacer chaque valeur « CHANGE-MOI ».
# Ce fichier contient des secrets : il n'est jamais envoyé sur GitHub (.gitignore).

# Mot de passe de la base PostgreSQL. Générer avec : openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE-MOI

# Secret de signature des connexions. Générer avec : openssl rand -hex 48
JWT_SECRET=CHANGE-MOI

# Mot de passe initial du compte « admin » (12 caractères minimum), à changer dans l'app après la première connexion
ADMIN_BOOTSTRAP_PASSWORD=CHANGE-MOI

# Adresses publiques
PUBLIC_URL=https://api.pepsgoal.fr
CORS_ORIGINS=https://app.pepsgoal.fr

# Version minimale de l'app acceptée (à augmenter seulement si l'API change de façon incompatible)
MIN_APP_VERSION=1.0.0
DB_POOL_MAX=10
DB_PREPARE=true
