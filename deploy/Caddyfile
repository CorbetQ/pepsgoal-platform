# Caddy obtient et renouvelle seul les certificats HTTPS (Let's Encrypt) dès que le DNS pointe vers le VPS.
{
	email quentin-corbet@outlook.fr
}

# API utilisée par l'application mobile
api.pepsgoal.fr {
	encode zstd gzip
	reverse_proxy server:8080
}

# Site public : accueil et pages légales (/cgu, /mentions-legales, /confidentialite)
pepsgoal.fr {
	root * /srv/site
	encode zstd gzip
	# Documents légaux : générés avec la version web (mêmes textes que dans l'application)
	@legal path /cgu /mentions-legales /confidentialite
	handle @legal {
		root * /srv/app/legal
		rewrite * {path}.html
		file_server
	}
	try_files {path} {path}.html {path}/index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
}

www.pepsgoal.fr {
	redir https://pepsgoal.fr{uri} permanent
}

# Version web de l'app (compilée par deploy/web-build.sh dans deploy/app)
app.pepsgoal.fr {
	root * /srv/app
	encode zstd gzip
	# Application d'une seule page : toute adresse inconnue renvoie index.html
	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@html path / /index.html
	header @html Cache-Control "no-cache"
	@static path /fonts/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
