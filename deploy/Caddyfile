# Caddy obtient et renouvelle seul les certificats HTTPS (Let's Encrypt) dès que le DNS pointe vers le VPS.
{
	email quentin-corbet@outlook.fr
}

# API utilisée par l'application mobile
api.pepsgoal.fr {
	encode zstd gzip
	reverse_proxy server:8080
}

# Site vitrine (deploy/site, généré par deploy/site-src/build.mjs), pages légales comprises (/cgu, /mentions-legales, /confidentialite)
pepsgoal.fr {
	root * /srv/site
	encode zstd gzip
	try_files {path} {path}.html {path}/index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@siteStatic path /fonts/* /emoji/*
	header @siteStatic Cache-Control "public, max-age=31536000, immutable"
	handle_errors {
		rewrite * /404.html
		file_server
	}
}

www.pepsgoal.fr {
	redir https://pepsgoal.fr{uri} permanent
}

# Version web de l'app (compilée par deploy/web-build.sh dans deploy/app)
app.pepsgoal.fr {
	root * /srv/app
	encode zstd gzip
	# Application d'une seule page : toute adresse inconnue renvoie index.html
	try_files {path} /index.html
	file_server
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}
	@html path / /index.html
	header @html Cache-Control "no-cache"
	@static path /fonts/* /emoji/*
	header @static Cache-Control "public, max-age=31536000, immutable"
}
