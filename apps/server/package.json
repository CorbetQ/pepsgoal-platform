{
  "name": "@pepsgoal/server",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "API PepsGoal : comptes, synchronisation hors ligne, fonctions sociales et modération.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "migrate": "node dist/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/helmet": "^11.1.1",
    "@fastify/multipart": "^8.3.0",
    "@fastify/rate-limit": "^9.1.0",
    "@fastify/static": "^7.0.4",
    "@pepsgoal/shared": "*",
    "bcryptjs": "^2.4.3",
    "drizzle-orm": "^0.33.0",
    "fastify": "^4.28.1",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^6.9.15",
    "postgres": "^3.4.4",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^6.4.16",
    "drizzle-kit": "^0.24.2",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
