# Copier ce fichier en .env puis adapter les valeurs.
NODE_ENV=development
PORT=8080
DATABASE_URL=postgres://pepsgoal:pepsgoal@localhost:5432/pepsgoal
# Secret de signature des jetons : au moins 32 caractères aléatoires (ex. `openssl rand -base64 48`)
JWT_SECRET=remplace-moi-par-une-longue-chaine-aleatoire-de-48-caracteres
# Origines web autorisées (séparées par des virgules). Production : https://app.pepsgoal.fr
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
# Adresse publique de l'API. Production : https://api.pepsgoal.fr (test : https://staging-api.pepsgoal.fr)
PUBLIC_URL=http://localhost:8080
MEDIA_DIR=./media
# Mot de passe du compte « admin » créé au premier démarrage (obligatoire en production, 12 caractères minimum)
ADMIN_BOOTSTRAP_PASSWORD=
# Version minimale de l'application acceptée par l'API
MIN_APP_VERSION=1.1.0
# Nombre maximal de connexions PostgreSQL du serveur
DB_POOL_MAX=10
# Mettre à false derrière PgBouncer en mode « transaction »
DB_PREPARE=true
