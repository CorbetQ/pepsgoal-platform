{
  "name": "@pepsgoal/app",
  "version": "1.2.0",
  "private": true,
  "main": "index.js",
  "description": "Application mobile PepsGoal (iOS et Android) : l'interface PepsGoal embarquée, fonctionne hors ligne et se synchronise avec le serveur.",
  "scripts": {
    "webapp": "node ../web/build.mjs",
    "start": "npm run webapp && expo start",
    "ios": "npm run webapp && expo start --ios",
    "android": "npm run webapp && expo start --android",
    "typecheck": "tsc --noEmit",
    "eas-build-post-install": "npm run webapp",
    "build:ios": "eas build --platform ios --profile production",
    "build:android": "eas build --platform android --profile production",
    "submit:ios": "eas submit --platform ios --profile production",
    "submit:android": "eas submit --platform android --profile production"
  },
  "dependencies": {
    "expo": "~51.0.28",
    "expo-file-system": "~17.0.1",
    "expo-sharing": "~12.0.1",
    "expo-splash-screen": "~0.27.7",
    "expo-status-bar": "~1.12.1",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-safe-area-context": "4.10.5",
    "react-native-webview": "13.8.6"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/react": "~18.2.79",
    "typescript": "~5.3.3"
  }
}
