{
  "expo": {
    "name": "PepsGoal",
    "slug": "pepsgoal",
    "scheme": "pepsgoal",
    "version": "2.1.5",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#07081A",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#07081A"
    },
    "ios": {
      "bundleIdentifier": "fr.pepsgoal.app",
      "buildNumber": "1",
      "supportsTablet": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "PepsGoal accède à tes photos pour ta photo de profil, tes publications et tes stories.",
        "NSCameraUsageDescription": "PepsGoal utilise l'appareil photo pour ta photo de profil, tes publications et tes stories.",
        "NSMicrophoneUsageDescription": "PepsGoal utilise le micro uniquement pendant l'enregistrement d'un message vocal."
      }
    },
    "android": {
      "package": "fr.pepsgoal.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#07081A"
      },
      "permissions": [
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS"
      ],
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": []
  }
}
